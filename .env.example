# Copy to .env locally. scripts/initialize.ps1 generates unique secrets automatically.
ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_DB=quantaedge_ai
POSTGRES_USER=qeai
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql+asyncpg://qeai:REPLACE_WITH_RANDOM_HEX_PASSWORD@127.0.0.1:5432/quantaedge_ai
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_BASE_URL=http://127.0.0.1:11434
CONFIG_DIR=D:/QuantaEdgeAI/projects/knowledge-engine/config
DATA_DIR=D:/QuantaEdgeAI/data
SERVICE_API_KEYS={"local-admin":{"key":"REPLACE_WITH_64_CHAR_RANDOM_KEY","scopes":["*"]},"quantaedge-backend":{"key":"REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_KEY","scopes":["chat","learning","embeddings","models:read","knowledge:read","memory:read","memory:write","memory:delete"]},"deepseek-harness":{"key":"REPLACE_WITH_A_THIRD_64_CHAR_RANDOM_KEY","scopes":["chat","models:read"]}}
API_REQUEST_TIMEOUT_SECONDS=180
